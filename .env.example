# Server
GAP_SERVER_ADDR=:8080
GAP_SERVER_ADMIN_KEY=change-me-admin-key
# Slowloris guards and the cap on a proxied client request body (413 above it).
GAP_SERVER_READ_TIMEOUT=60s
GAP_SERVER_IDLE_TIMEOUT=120s
GAP_SERVER_MAX_REQUEST_BYTES=10485760

# Auth (Grok CLI auth.json)
GAP_AUTH_FILE=/config/auth.json
GAP_AUTH_UPSTREAM_BASE=https://api.x.ai/v1
GAP_AUTH_REFRESH_SKEW=5m
# GAP_AUTH_ISSUER=https://auth.x.ai
# GAP_AUTH_CLIENT_ID=

# Database (sqlite path or postgres DSN)
# Prefer external Postgres in production (no PVC needed).
# GAP_DB_DRIVER=sqlite
# GAP_DB_DSN=./data/proxy.db
GAP_DB_DRIVER=postgres
GAP_DB_DSN=host=postgres user=proxy password=proxy dbname=proxy port=5432 sslmode=disable

# Rate limiting
GAP_RATE_LIMIT_RPS=10
GAP_RATE_LIMIT_BURST=20

# Logging
GAP_LOG_LEVEL=info
GAP_LOG_REDACT=true

# Audit (request/response bodies stored in DB; access via /admin/audit)
# max_body_bytes caps only what is STORED; it never truncates the proxied request.
GAP_AUDIT_ENABLED=true
GAP_AUDIT_MAX_BODY_BYTES=65536

# Metrics
GAP_METRICS_ENABLED=true
